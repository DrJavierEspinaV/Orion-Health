:root{
    --bg:#f7fbff; --card:#fff; --text:#0f172a; --muted:#64748b; --pri:#2563eb;

    --top-offset: 18mm;        /* cabecera vertical */
    --footer-bottom: 20mm;     /* pie vertical */

    --firma-h: 100px;          /* altura firma */
    --firma-line-w: 180px;     /* ancho línea firma */

    --receta-font: 11pt;  --receta-line: 1.20;
    --ind-font: 11pt;     --ind-line: 1.20;

    --hdr-row-gap: 0.25rem;
    --safe-gap-over-footer: calc(var(--firma-h) + 10mm);

    /* --- NUEVO: control de tamaños del pie --- */
    --brand-logo-h: 32px;      /* alto logo por defecto (hojas 1–2) */
    /* overrides solo para Hoja 3 (se activan en #printDoc) */
    /* --brand-logo-h-3: 36px; */
    /* --firma-h-3: 110px; */
  }

  body{background:var(--bg);color:var(--text)}
  .card{background:var(--card);border:1px solid #e5e7eb;border-radius:16px;box-shadow:0 8px 24px rgba(15,23,42,.06)}
  .chip{border:1px dashed #cbd5e1;border-radius:999px;padding:.25rem .6rem;font-size:.8rem}
  #printSheet, #printSheet2, .card{ border:0 !important; box-shadow:none !important; border-radius:0 !important; }
  .actions-bottom{ position:sticky; bottom:0; z-index:40; background:#ffffffE6; backdrop-filter:saturate(180%) blur(4px); }

  #printSheet pre, #printSheet2 pre{
    white-space:pre-wrap; font-family:inherit;
    font-size:13px; line-height:1.16; margin-top:.2rem;
  }
  .dateBox{ white-space:nowrap; font-size:12px }
  #printSheet hr, #printSheet2 hr{ margin:2px 0 4px 0; }
  .section{ margin-top:10px; }
  .diagline{ margin-top:8px; margin-bottom:8px; }

  .hdrgrid{
    display:grid;
    grid-template-columns: 70% 30%;
    column-gap: 1rem;
    row-gap: var(--hdr-row-gap);
  }
  .hdrgrid p{ margin:0; text-align:left !important; justify-self:start; line-height:1.12; }
  .wrap{ overflow-wrap: normal; word-break: normal; white-space: normal; }

  #contentWrap, #contentWrap2{ padding-bottom: var(--safe-gap-over-footer); }
  #v_receta{ font-size: var(--receta-font); line-height: var(--receta-line); }
  #v_ind, #v_ind2{ font-size: var(--ind-font); line-height: var(--ind-line); }
  .avoid-break{ break-inside:avoid; page-break-inside:avoid; }

  /* ==== CAMBIO: selectores generalizados para cualquier pie (#fixedFoot, #fixedFoot2, #fixedFoot3) ==== */
  [id^="fixedFoot"]{
    position:absolute; left:0; right:0; bottom: var(--footer-bottom);
    display:grid; grid-template-columns:1fr auto; align-items:end; column-gap:10px;
  }
  [id^="fixedFoot"] .brand{
    display:inline-flex; gap:8px; align-items:center; color:#475569; font-size:.80rem; line-height:1;
  }
  [id^="fixedFoot"] .brand .logo{
    /* usa override 3 si existe, si no el global */
    max-height: var(--brand-logo-h-3, var(--brand-logo-h));
    width:auto; display:block;
  }
  [id^="fixedFoot"] .sigBox{ display:flex; flex-direction:column; align-items:center; justify-content:flex-end; }
  [id^="fixedFoot"] .sigBox .firmaimg{
    height: var(--firma-h-3, var(--firma-h));
    width:auto; display:block; opacity:.98; margin-bottom:4px;
  }
  [id^="fixedFoot"] .sigBox .sig-line{ width: var(--firma-line-w); border-top:1px solid #94a3b8; margin:4px auto; }
  [id^="fixedFoot"] .sigBox .name{ font-weight:700; color:#000; font-size:.95rem; }

  .page{
    position:relative;
    box-sizing:border-box;
    height:8.5in;
    padding-top:var(--top-offset);
    page-break-after:auto;
  }
  .force-break{ page-break-after:always !important; }
  #printSheet2.hidden{ display:none !important; }

  @media print{
    @page { size:5.5in 8.5in; margin:7mm }
    .no-print{ display:none !important }
    body { background:#fff !important }

    .page{
      box-sizing: border-box;
      height: calc(8.5in - 14mm);
      padding-top: var(--top-offset);
    }

    #printSheet, #printSheet2{ position:relative; min-height:0; }
    #printSheet h3, #printSheet2 h3{ font-size:17px; margin:0 0 2px 0 }
    #printSheet h4, #printSheet2 h4{ font-size:13px; margin:4px 0 2px 0 }
    #printSheet pre, #printSheet2 pre{ font-size:11px; line-height:1.2; margin-top:2px }
    #v_receta{ font-size:11px; line-height:1.20 }
    .dateBox{ font-size:10px }
    #printSheet hr, #printSheet2 hr{ margin:1px 0 3px 0 }
    .diagline{ margin-top:3m