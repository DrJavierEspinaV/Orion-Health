ground:#e0e7ff; border-color:#c7d2fe; color:#1e3a8a}
    .links-preview{margin-top:8px; font-size:12px; color:#0f172a; background:#f8fbff; border:1px dashed var(--stroke-2); border-radius:10px; padding:8px}
    .footer{font-size:.95em; color:#475569; border-top:1px solid var(--stroke); padding:12px 20px 24px; display:flex; align-items:center; gap:10px}
    .editable{border:1px solid rgba(15,23,42,.08); border-radius:14px; padding:14px;}
    body.theme-orion{--bg:#f5f9ff; --card:#ffffff; --primary:#0e7490; --stroke:#dbe7ff; --stroke-2:#c7d2fe; --whatsapp:#25D366;}
    body.theme-orion header{background:linear-gradient(90deg,#f0f7ff 0%, #eaf3ff 100%); border-bottom-color:var(--stroke);}
    body.theme-orion .btn.primary{background:var(--primary); color:#fff;}
    body.theme-orion .card{box-shadow:0 8px 24px rgba(14,116,144,.08);}

    #opList label:hover{background:#f8fbff}

    header#orionHdr{
      display:inline-flex;
      align-items:center;
      gap:16px;
      padding:12px 20px;
      border-bottom:1px solid var(--stroke);
      background:#FBFAF9;
    }
    header#orionHdr img{
      height:78px;
      width:auto;
      object-fit:contain;
    }
    header#orionHdr .hgroup{ line-height:1.15; }
    header#orionHdr .hgroup h1{
      margin:0; font-weight:800; color:var(--text);
      font-size:clamp(28px,2.2vw,34px);
    }
    header#orionHdr .hgroup .r{ font-weight:900; font-size:0.8em; }
    header#orionHdr .hgroup p{
      margin:4px 0 0; color:var(--muted);
      font-size:clamp(14px,1.1vw,16px);
    }

    .crm-layout{
      display:grid;
      grid-template-columns: minmax(640px, 1fr) 760px;
      gap: 22px;
      align-items:start;
    }
    .crm-sidebar{
      position: sticky;
      top: 16px;
      max-height: calc(100vh - 32px);
      overflow: auto;
      padding-right: 6px;
    }
    .crm-sidebar .card{ margin-top: 0 !important; }
    .crm-sidebar .card + .card{ margin-top: 14px !important; }

    .crm-sidebar .card.table{ overflow: hidden; }
    #list{ max-height: 58vh; overflow: auto; }

    @media (max-width: 1200px){
      .crm-layout{ grid-template-columns: 1fr; }
      .crm-sidebar{ position: relative; top:auto; max-height:none; overflow: visible; padding-right:0; }
      #list{ max-height:none; overflow: visible; }
    }

    .crm-sidebar{ width: 760px; }
    @media (min-width: 1500px){
      .crm-layout{ grid-template-columns: minmax(700px, 1fr) 820px; }
      .crm-sidebar{ width: 820px; }
    }
    .crm-sidebar .tHead, .crm-sidebar .tRow{ font-size: 13px; }
    .crm-sidebar .tHead > div, .crm-sidebar .tRow > div{ padding: 10px 10px !important; }
    .crm-sidebar .tHead{ position: sticky; top: 0; background: #f8fbff; z-index: 5; }

    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start;}
    @media (max-width:820px){.grid2{grid-template-columns:1fr;}}

    .surveyBox{
      margin-top:12px;
      border:1px solid rgba(15,23,42,.08);
      border-radius:14px;
      padding:14px;
      background:#fff;
    }
    .surveyTop{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:10px;
    }
    .surveyTop .left{
      display:flex;
      align-items:center;
      gap:10px;
    }
    .surveyTop input[type="checkbox"]{ transform:scale(1.1); }
    .surveyRow{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:12px;
    }
    @media (max-width:820px){ .surveyRow{ grid-template-columns:1fr; } }
    .surveyBox textarea{ min-height:140px; }
    .surveyHint{ font-size:12px; color:var(--muted); margin-top:6px; }

    .date-filter-row{margin-top:12px; display:flex; gap:12px; flex-wrap:wrap}
    .date-filter-actions{display:flex; align-items:flex-end; gap:10px}
    .filter-chip{display:inline-flex; align-items:center; gap:8px; margin-top:10px; padding:8px 12px; border-radius:999px; border:1px solid var(--stroke-2); background:#f8fbff; color:#1e3a8a; font-size:12px; font-weight:700}
    .filter-chip[hidden]{display:none !important}
    .doc-status{margin-top:14px; border:1px solid var(--stroke-2); border-radius:16px; background:#f8fbff; padding:14px 16px; display:flex; align-items:center; justify-content:s