pace-between; gap:14px; flex-wrap:wrap}
    .doc-status-info{display:flex; flex-direction:column; gap:4px}
    .doc-status-title{font-size:12px; font-weight:900; text-transform:uppercase; letter-spacing:.35px; color:#0b6bcb}
    .doc-status-name{font-size:14px; font-weight:800; color:#0f172a}
    .doc-status-meta{font-size:12px; color:var(--muted)}
    .doc-status-badge{display:inline-flex; align-items:center; justify-content:center; min-height:34px; padding:0 14px; border-radius:999px; border:1px solid var(--stroke-2); background:#eef2ff; color:#1e3a8a; font-size:12px; font-weight:800}
    .doc-status-badge.active{background:#dcfce7; border-color:#bbf7d0; color:#166534}
    .auto-slot-card{margin-top:12px; border:2px solid rgba(14,165,233,.32); border-radius:18px; background:linear-gradient(135deg,#eff6ff 0%,#ecfeff 100%); padding:14px 16px; box-shadow:0 10px 24px rgba(14,165,233,.10)}
    .auto-slot-card[hidden]{display:none !important}
    .auto-slot-top{display:flex; align-items:flex-start; justify-content:space-between; gap:12px; flex-wrap:wrap}
    .auto-slot-kicker{font-size:11px; font-weight:900; color:#0b6bcb; text-transform:uppercase; letter-spacing:.35px}
    .auto-slot-name{font-size:18px; font-weight:900; color:#0f172a; margin-top:3px; line-height:1.15}
    .auto-slot-meta{font-size:12px; color:#475569; margin-top:4px; line-height:1.35}
    .auto-slot-badge{display:inline-flex; align-items:center; justify-content:center; min-height:32px; padding:0 12px; border-radius:999px; background:#0b6bcb; color:#fff; font-size:12px; font-weight:900; white-space:nowrap}
    .auto-slot-actions{display:flex; gap:8px; flex-wrap:wrap; margin-top:12px}
    .auto-slot-btn{padding:8px 12px !important; border-radius:999px !important; font-size:12px !important}
    .row.franja-auto-active > div{background:linear-gradient(90deg, rgba(14,165,233,.30) 0%, rgba(219,234,254,.88) 54%, rgba(255,255,255,0) 100%) !important}
    .row.franja-auto-active > div:first-child{box-shadow:inset 5px 0 0 #0ea5e9}

/* ===============================
   ORION — Dashboard Clínico (B) v1
   Solo estética (no toca lógica)
   =============================== */
:root{
  --bg: #f3f6fb;
  --card: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --border: rgba(15, 23, 42, .10);
  --shadow: 0 10px 30px rgba(2,6,23,.08);
  --shadow2: 0 6px 16px rgba(2,6,23,.06);
  --radius: 18px;
  --primary: #0b6bcb;
  --primary2:#0ea5e9;
  --success:#16a34a;
  --danger:#ef4444;
}

html, body{
  background: radial-gradient(1100px 600px at 15% 0%, rgba(14,165,233,.18), transparent 55%),
              radial-gradient(900px 500px at 90% 15%, rgba(11,107,203,.16), transparent 55%),
              var(--bg) !important;
  color: var(--text) !important;
}

header{
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(243, 246, 251, .82);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
}

header h1{
  font-size: 30px !important;
  letter-spacing: -0.02em;
  margin: 0;
}
header .sub{
  color: var(--muted) !important;
  font-size: 13px !important;
}

.container{
  max-width: 1280px !important;
  padding-top: 18px !important;
}
.grid{ gap: 18px !important; }

.card{
  background: var(--card) !important;
  border: 1px solid var(--border) !important;
  border-radius: var(--radius) !important;
  box-shadow: var(--shadow2) !important;
}

.small, label.small{
  color: var(--muted) !important;
  font-weight: 500 !important;
  font-size: 12px !important;
}

input[type="text"], input[type="date"], select, textarea{
  border: 1px solid rgba(15,23,42,.14) !important;
  border-radius: 14px !important;
  background: rgba(255,255,255,.98) !important;
  padding: 10px 12px !important;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
}
textarea{ min-height: 140px; }

button, .btn{
  border-radius: 14px !important;
  font-weight: 800 !important;
  box-shadow: 0 8px 18px rgba(2,6,23,.10) !important;
  transition: transform .08s ease, box-shadow .15s ease, filter .15s ease;
}
button:hover, .btn:hover{ transform: translateY(-1px); filter: brightness(1.02); }
button:active, .btn:active{ transform: translateY(0px); box-shadow: 0 6px 12px rgba(2,6,23,.10) !important; }

