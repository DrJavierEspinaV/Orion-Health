:root{
      --bg:#FBFAF9; --card:#FBFAF9; --muted:#64748b; --text:#0f172a; --primary:#2563eb;
      --badge:#eef2ff; --stroke:#d7e1ee; --stroke-2:#c2d0e6; --whatsapp:#25D366;
      --col-paciente:3.85fr; --col-run:.72fr; --col-fecha:.60fr; --col-hora:.44fr; --col-status:.58fr; --col-motivo:.62fr; --col-accion:0fr;
    }
    *{box-sizing:border-box}
    body{margin:0; font-family:Inter,Arial,Helvetica,sans-serif; background:var(--bg); color:var(--text)}
    header{display:flex; align-items:center; gap:16px; padding:0 20px; border-bottom:1px solid var(--stroke); background:#FBFAF9}
    header img{height:200px}
    .headtext{display:flex; flex-direction:column}
    h1{font-size:22px; margin:0; font-weight:800}
    .sub{color:var(--muted); margin-top:4px}
    main{max-width:1700px; margin:0 auto; padding:20px; width:min(1700px, 96vw)}
    .card{background:var(--card); border:1px solid var(--stroke); border-radius:14px; padding:16px; box-shadow:0 6px 16px rgba(15,23,42,.06); margin-bottom:20px}
    .bar{display:grid; grid-template-columns:1.2fr 1fr 1fr 1fr; gap:12px; align-items:end}
    .bar-2{display:grid; grid-template-columns:1fr 1fr; gap:12px}
    label.small{font-size:12px; color:var(--muted); font-weight:500}
    input[type="file"], select, textarea, input[type="text"], input[type="tel"], input[type="date"]{width:100%; padding:12px 14px; border-radius:12px; border:1px solid var(--stroke-2); background:#fff; color:#0f172a}
    textarea{min-height:72px; resize:vertical}
    #mensajeTipo{min-height:150px;}
    .btn{appearance:none; border:1px solid var(--stroke-2); background:#eef5ff; color:#0f172a; padding:12px 16px; border-radius:12px; cursor:pointer; font-weight:800; text-decoration:none; display:inline-block; text-align:center}
    .btn:hover{background:#dbe8ff}
    .btn.primary{background:var(--primary); color:#fff; border-color:transparent}
    .btn.whatsapp{background:var(--whatsapp); color:#fff; border-color:transparent}
    .btn.sent{background:#ef4444}
    .table{display:grid; grid-template-columns:var(--col-paciente) var(--col-run) var(--col-fecha) var(--col-hora) var(--col-status) var(--col-motivo); gap:0; border:1px solid var(--stroke); border-radius:12px; overflow:hidden; font-size:13px}
    .header, .row{display:contents} #list{display:contents}
    .header > div{font-weight:800; text-transform:uppercase; background:#f3f7ff; padding:9px 5px; border-bottom:2px solid var(--stroke); min-width:0; font-size:10px; letter-spacing:.02em; line-height:1.08}
    .row > div{padding:9px 5px; border-bottom:1px solid var(--stroke); display:flex; align-items:center; min-height:42px; min-width:0; font-size:11.5px; line-height:1.05}
    .row > div:first-child{flex-direction:column; align-items:flex-start}
    .paciente-nombre{font-weight:800; line-height:1.1; word-break:break-word; font-size:13.5px} .muted{color:var(--muted); font-size:10.5px; margin-top:2px}
    .paciente-top{width:100%; display:flex; align-items:center; justify-content:flex-start; gap:4px; flex-wrap:nowrap; margin-bottom:7px; overflow-x:auto; overflow-y:hidden; padding-bottom:2px; scrollbar-width:thin}
    .paciente-top::-webkit-scrollbar{height:4px}
    .paciente-top::-webkit-scrollbar-thumb{background:#cbd5e1; border-radius:999px}
    .udc-wrap{display:inline-flex; align-items:center; gap:4px; padding:3px 6px; border:1px solid var(--stroke-2); border-radius:999px; background:#f8fbff; user-select:none; flex:0 0 auto; transition:all .15s ease}
    .udc-check{width:12px; height:12px; margin:0; cursor:pointer; accent-color:#0b6bcb}
    .udc-label{font-size:9.5px; font-weight:900; letter-spacing:.2px; color:#0b6bcb; cursor:pointer; white-space:nowrap}
    .udc-wrap.active{background:#0b6bcb; border-color:#064f99; box-shadow:0 0 0 2px rgba(11,107,203,.18)}
    .udc-wrap.active .udc-label{color:#fff}
    .udc-wrap.active .udc-check{accent-color:#fff}
    .row.udc-active > div:first-child{background:linear-gradient(90deg, rgba(11,107,203,.22) 0%, rgba(14,165,233,.08) 68%, rgba(14,165,233,0) 100%)}
    .retraso-wrap{display:inline-flex; align-items:center; gap:4px; padding:3px 6px; border:1px solid var(--stroke-2); border-radius:999px; background:#fff7ed; user-sel