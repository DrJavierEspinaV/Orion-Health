ect:none; flex:0 0 auto; transition:all .15s ease}
    .retraso-check{width:12px; height:12px; margin:0; cursor:pointer; accent-color:#f97316}
    .retraso-label{font-size:9px; font-weight:900; letter-spacing:.15px; color:#c2410c; cursor:pointer; white-space:nowrap}
    .retraso-wrap.retraso-llegada{background:#fff7ed; border-color:#fdba74}
    .retraso-wrap.retraso-llegada .retraso-check{accent-color:#ea580c}
    .retraso-wrap.retraso-llegada .retraso-label{color:#9a3412}
    .retraso-wrap.retraso-llegada.active{background:#ea580c; border-color:#c2410c; box-shadow:0 0 0 2px rgba(234,88,12,.20)}
    .retraso-wrap.retraso-llegada.active .retraso-label{color:#fff}
    .retraso-wrap.retraso-llegada.active .retraso-check{accent-color:#fff}
    .retraso-wrap.retraso-atencion{background:#fff1f2; border-color:#fda4af}
    .retraso-wrap.retraso-atencion .retraso-check{accent-color:#e11d48}
    .retraso-wrap.retraso-atencion .retraso-label{color:#be123c}
    .retraso-wrap.retraso-atencion.active{background:#e11d48; border-color:#9f1239; box-shadow:0 0 0 2px rgba(225,29,72,.22)}
    .retraso-wrap.retraso-atencion.active .retraso-label{color:#fff}
    .retraso-wrap.retraso-atencion.active .retraso-check{accent-color:#fff}
    .retraso-estimado-wrap{display:inline-flex; align-items:center; gap:3px; padding:2px 5px; border:1px solid #cbd5e1; border-radius:999px; background:#f8fafc; flex:0 0 auto; transition:all .15s ease}
    .retraso-estimado-wrap.active{background:#0f172a; border-color:#020617; box-shadow:0 0 0 2px rgba(15,23,42,.15)}
    .retraso-estimado-wrap.active .retraso-estimado-label{color:#fff}
    .retraso-estimado-label{font-size:9.5px; font-weight:900; color:#475569}
    .retraso-minutos{width:auto !important; min-width:70px; max-width:82px; padding:2px 5px !important; border-radius:999px !important; font-size:10px; font-weight:900; background:#fff !important}
    .retraso-minutos:disabled{opacity:.55; cursor:not-allowed}
    .row.retraso-active > div:first-child{background:linear-gradient(90deg, rgba(225,29,72,.24) 0%, rgba(244,63,94,.10) 70%, rgba(225,29,72,0) 100%)}
    .row.retraso-llegada-active > div:first-child{background:linear-gradient(90deg, rgba(234,88,12,.26) 0%, rgba(251,146,60,.12) 70%, rgba(234,88,12,0) 100%)}
    .btn.whatsapp.wa-action{display:inline-flex; align-items:center; justify-content:center; min-width:112px; max-width:145px; min-height:32px; padding:6px 10px !important; white-space:normal; line-height:1.05; font-size:11px; border-radius:999px !important; box-shadow:0 4px 10px rgba(2,6,23,.10)!important; flex:0 0 auto}
    .btn.whatsapp.wa-retraso-llegada{background:#f59e0b !important; color:#fff !important}
    .btn.whatsapp.wa-retraso-atencion{background:#e11d48 !important; color:#fff !important}
    .right{justify-content:flex-end; width:100%; overflow:visible}

    .header > div:nth-child(7), .row > div:nth-child(7){display:none !important}
    #whatsappManualCard{display:none}
    #whatsappManualCard.manual-visible{
      display:block !important;
      border:2px solid rgba(37,211,102,.45) !important;
      background:linear-gradient(135deg,#f0fdf4 0%,#ffffff 100%) !important;
    }
    #whatsappManualCard .manual-title{
      font-size:13px;
      font-weight:900;
      color:#166534;
      text-transform:uppercase;
      letter-spacing:.25px;
      margin-bottom:10px;
    }
    .wa-row-line{width:100%; display:flex; justify-content:flex-start; margin-top:7px}
    .row > div:nth-child(2), .row > div:nth-child(3), .row > div:nth-child(4), .row > div:nth-child(5), .row > div:nth-child(6){justify-content:center; text-align:center}
    .row > div:nth-child(6){font-size:10.8px; line-height:1.06; word-break:break-word}
    .row > div:nth-child(2), .row > div:nth-child(3), .row > div:nth-child(4){font-size:11px; font-weight:700}
    .pill{font-size:11px; padding:3px 8px}
    .pill{display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; font-size:12px; background:#eef2ff; border:1px solid var(--stroke-2)}
    .pill.ausente{background:#fee2e2; border-color:#fecaca; color:#991b1b}
    .pill.ok{background:#dcfce7; border-color:#bbf7d0; color:#065f46}
